{
    "redirects": [
        {
            "source": "/krate",
            "destination": "/docs/krate",
            "permanent": false
        },
        {
            "source": "/krate/(.*)",
            "destination": "/docs/krate",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
