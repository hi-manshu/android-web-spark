{
    "redirects": [
        {
            "source": "/krate",
            "destination": "/docs/krate",
            "permanent": false
        },
        {
            "source": "/krate/(.*)",
            "destination": "/docs/krate",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|WhatsApp|TelegramBot|Discordbot|Pinterest|Embedly|redditbot|Applebot|Googlebot|bingbot).*"
                }
            ],
            "destination": "/api/share?path=/"
        },
